# ========================================
# CredChain Environment Variables
# ========================================
# NEVER commit real values. Copy to .env

# --- Blockchain ---
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
DEPLOYER_PRIVATE_KEY=0x_YOUR_TESTNET_PRIVATE_KEY_ONLY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# --- Deployed Contract Addresses (set after deployment) ---
NEXT_PUBLIC_CRED_TOKEN_ADDRESS=0x...
NEXT_PUBLIC_LOAN_MANAGER_ADDRESS=0x...
NEXT_PUBLIC_LOAN_ESCROW_ADDRESS=0x...
NEXT_PUBLIC_LOAN_GOVERNANCE_ADDRESS=0x...
NEXT_PUBLIC_COLLATERAL_ORACLE_ADDRESS=0x...
NEXT_PUBLIC_BORROWER_REPUTATION_ADDRESS=0x...

# --- Chainlink ---
NEXT_PUBLIC_CHAINLINK_ETH_USD_FEED=0x694AA1769357215DE4FAC081bf1f309aDC325306

# --- Backend ---
DATABASE_URL=sqlite:///./credchain.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/credchain
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CHAIN_ID=11155111
NEXT_PUBLIC_NETWORK_NAME=Sepolia
